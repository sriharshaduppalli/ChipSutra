  "anti_patterns": [
    {"id": "ap_fake_ports", "label": "Invented data_in/data_out on real DUT", "detect": "port_map_mismatch"},
    {"id": "ap_circ_golden", "label": "exp = count + 1 circular golden", "detect": "circular_golden"},
    {"id": "ap_bad_clk", "label": "clk=~clk; forever @(posedge clk)", "detect": "bad_or_missing_clock"},
    {"id": "ap_directed_wall", "label": "Unrolled Testcase 1..N asserts", "detect": "directed_case_spam"},
    {"id": "ap_fake_uvm", "label": "Fake UVM APIs (.put, configure(vif))", "detect": "fake_uvm_api"},
    {"id": "ap_essay", "label": "Markdown essay after endmodule", "detect": "chat_prose"},
    {"id": "ap_fifo_stim_only", "label": "FIFO TB without queue scoreboard", "detect": "missing_fifo_golden"},
    {"id": "ap_axi_illegal", "label": "AXI random every cycle without handshakes", "detect": "illegal_axi_stim"},
    {"id": "ap_axi_valid_wait", "label": "AXI VALID waits for READY (deadlock)", "detect": "illegal_axi_stim"},
    {"id": "ap_ahb_hwrite_race", "label": "Drop HWRITE in same timeslot as address posedge", "detect": "ahb_addr_data_race"},
    {"id": "ap_apb_wait_hold", "label": "Change PSEL/PENABLE/PADDR while PREADY is LOW", "detect": "apb_wait_hold"},
    {"id": "ap_bad_depth", "label": "Hardcoded depth ignoring DUT DEPTH param", "detect": "param_mismatch"}
  ],
