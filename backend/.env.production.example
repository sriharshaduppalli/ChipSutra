# ChipSutra production backend — copy to backend/.env on the server
# cp backend/.env.production.example backend/.env
#
# Never commit backend/.env. Rotate all values from development.

## MongoDB Atlas (required for production)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/chipsutra_prod?retryWrites=true&w=majority
DB_NAME=chipsutra_prod

## CORS — exact portal origins (comma-separated, no spaces required)
CORS_ORIGINS=https://chipsutra.org,https://www.chipsutra.org
FRONTEND_URL=https://chipsutra.org

## Auth
JWT_SECRET=REPLACE_WITH_64_HEX_FROM_python_-c_import_secrets_print_secrets_token_hex_32
ADMIN_EMAIL=admin@chipsutra.org
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

APP_NAME=chipsutra

## Public portal abuse controls
FREE_DAILY_QUOTA=100
REQUIRE_EMAIL_VERIFICATION=false

TELEMETRY_ENABLED=false

## LLM — Docker prod compose overrides OLLAMA_URL to http://ollama:11434
OLLAMA_MODEL=chipsutra-vlsi:3b

STORAGE_MODE=local

## Optional quality tier (keys stay server-side only)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

## Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.chipsutra.org/api/auth/google/callback
