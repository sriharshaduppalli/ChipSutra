MONGO_URL="mongodb://localhost:27017"
DB_NAME="chipsutra_db"
CORS_ORIGINS="*"

# Emergent LLM Universal Key — get yours from https://app.emergent.sh (Profile → Universal Key)
EMERGENT_LLM_KEY="sk-emergent-..."

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me-64-hex-chars"

# Bootstrap admin (created on first backend startup)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeMe123!"

APP_NAME="chipsutra"
