## ================== ChipSutra Backend .env ==================
## Zero-key setup: leave everything below as-is. `docker compose up` will
## spin up a local Ollama server with an open-source code model and you can
## start generating testbenches immediately — no API key needed.

## MongoDB (required)
## Default docker-compose uses local Mongo: mongodb://mongo:27017 (set automatically).
## If Docker Hub cannot pull mongo:6, use MongoDB Atlas + docker-compose.atlas.yml — see docs/DOCKER_PULL_TROUBLESHOOTING.md
MONGO_URL="mongodb://localhost:27017"
DB_NAME="chipsutra_db"
## Lab default "*". For any shared/public portal pin origins and set CHIPSUTRA_PUBLIC_MODE=true
CORS_ORIGINS="http://localhost:3000"

## JWT — auto-generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me-generate-64-hex-chars"

## Public portal hardening (rate limits always on; these tighten defaults)
# CHIPSUTRA_PUBLIC_MODE=false
# CHIPSUTRA_REFUSE_MOCK_SIM=false
# CHIPSUTRA_BUS_SIM_GATE=auto

## Bootstrap admin (auto-created on first startup)
ADMIN_EMAIL="admin@chipsutra.local"
ADMIN_PASSWORD="ChangeMe-Str0ng!"

APP_NAME="chipsutra"

## Lab: 0 = unlimited. Public mode defaults to 50 if unset.
FREE_DAILY_QUOTA=0
REQUIRE_EMAIL_VERIFICATION=false

## Optional: anonymous startup telemetry (privacy-safe, only sends install_id + version)
## Enable to help ChipSutra count active installations. Opt-out is default.
TELEMETRY_ENABLED=false
# CHIPSUTRA_INSTALL_ID=""  # optional — persist a single install UUID across restarts

## ==== LLM providers (auto-detected) ====
## Product default: ChipSutra-VLSI via Ollama (OLLAMA_URL).
## Cloud Claude/GPT are hidden unless SHOW_CLOUD_MODELS=true.
##
## Docker compose already sets OLLAMA_URL=http://ollama:11434 for you.

# SHOW_CLOUD_MODELS=false
# EMERGENT_LLM_KEY=""
# ANTHROPIC_API_KEY=""              # optional cloud (only listed if SHOW_CLOUD_MODELS=true)
# OPENAI_API_KEY=""                 # optional cloud
OLLAMA_URL="http://ollama:11434"
# Local DV-tuned model (built by docker compose from models/chipsutra-vlsi/). No API credits.
OLLAMA_MODEL="chipsutra-vlsi:7b"
# Fallback if 7B not installed: chipsutra-vlsi:3b (router auto-falls back)
# CHIPSUTRA_MODEL_7B="chipsutra-vlsi:7b"
# CHIPSUTRA_MODEL_3B="chipsutra-vlsi:3b"
# CHIPSUTRA_MODEL_14B="chipsutra-vlsi:14b"   # GPU SoC/UVM tier (Modelfile.14b)
# CHIPSUTRA_PREFER_7B=true
# CHIPSUTRA_PREFER_14B=false                 # set true to prefer 14B when installed
# OLLAMA_NUM_PREDICT_SV_SIMPLE=1100         # layered counter/mux budget
# OLLAMA_NUM_PREDICT_SV_CLASS=1500          # bus/FIFO layered budget
# OLLAMA_HTTP_TIMEOUT=180                   # abort hung 7B generates; skeleton is the floor
# CHIPSUTRA_SKELETON_FIRST=true             # skip LLM when a DUT-matched golden exists
# Optional JSON path or inline object. Merged with selected RTL (ports win).
# Keys: scale, enable_ral, ip_hjson, top_hjson, protocol_knobs, memory_map, csr_list, topology
# ip_hjson: OpenTitan/reggen IP register file (same input ralgen uses). Not FuseSoC.
# Example: backend/knowledge/dv_config.example.json
# CHIPSUTRA_DV_CONFIG=
# CHIPSUTRA_LLM_REPAIR=true                 # second LLM pass only if lint still hard-fails
# OLLAMA_STOP="Certainly!\nHere is\nHope this helps"
# CPU threads for llama.cpp (omit = Ollama uses all cores; set to cap so Verilator can share)
# OLLAMA_NUM_THREAD=8
# GPU layers: omit = auto; 0 = CPU-only
# OLLAMA_NUM_GPU=0
# Parallel Verilator mutant runs during mutation_test (1-4; default min(4, CPU count))
# CHIPSUTRA_MUTATION_WORKERS=4
# Closed-loop Generate: sim-run + repair rounds + mutation (auto = when Verilator is on PATH)
# CHIPSUTRA_SIM_GATE=auto
# CHIPSUTRA_REPAIR_ROUNDS=2
# CHIPSUTRA_MUTATION=auto
# Incomplete Spec→RTL emits exploratory stub (set 0 to force LLM)
# CHIPSUTRA_SPEC_GATE=true
# CHIPSUTRA_MUTATION_MAX=4
# CHIPSUTRA_FAILFIX_JSONL=./storage/failfix.jsonl
# Tip: for fastest counter smoke use Engine = chipsutra-vlsi:3b
# Cut first-token latency on API startup (background ollama warm)
# OLLAMA_PREWARM=true
# Base weight tag pulled before `ollama create` (docker compose OLLAMA_BASE_MODEL)
# OLLAMA_BASE_MODEL="qwen2.5-coder:3b"
# Alternatives after running ChipSutra-VLSI-LLM scripts: chipsutra-vlsi:1.5b | chipsutra-vlsi:7b
# Raw Qwen (skip custom model): qwen2.5-coder:3b

## RAG (domain knowledge injection on Generate)
RAG_ENABLED=true
## Vector rerank (optional — needs: pip install -r requirements-rag.txt)
## auto = sentence-transformers if installed, else hashed-tfidf
# RAG_VECTOR_ENABLED=true
# RAG_VECTOR_BACKEND=auto
# Best small embedder trial winner (default in rag_vector.py):
# RAG_VECTOR_MODEL=BAAI/bge-small-en-v1.5
# Faster CPU alternative:
# RAG_VECTOR_MODEL=all-MiniLM-L6-v2
# Force keyword-only fallback:
# RAG_VECTOR_BACKEND=hashed-tfidf
# Trial bakeoff: python scripts/eval_rag_embedders.py
# Optional cross-encoder rerank (slower; needs sentence-transformers):
# RAG_RERANK_ENABLED=true
# RAG_RERANK_MODEL=BAAI/bge-reranker-base

## Optional Redis — shared rate limits across workers/replicas
## Leave unset for single-process in-memory limiting (default).
## With Docker: docker compose --profile redis up  then set:
# REDIS_URL="redis://redis:6379/0"

## Optional AsFigo clones (not vendored). See docs/ASFIGO_LINTERS.md
# CHIPSUTRA_SVALINT=
# CHIPSUTRA_FCOVLINT=
# CHIPSUTRA_SVCK=
# CHIPSUTRA_FPGALINT=
# CHIPSUTRA_FT_SVA_DIR=
# CHIPSUTRA_MATHLIB_DIR=
# CHIPSUTRA_IVL_UVM=
# CHIPSUTRA_SIM_ADAPTER=verilator
# CHIPSUTRA_ASFIGO=1

## Storage — auto: emergent if key present, else local disk
STORAGE_MODE="auto"
STORAGE_LOCAL_PATH="./storage"

## Google OAuth (optional). Leave blank to hide the Google button.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""
# FRONTEND_URL=""
