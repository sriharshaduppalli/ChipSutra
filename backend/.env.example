## ================== ChipSutra Backend .env ==================
## Copy to `.env` and fill in values.
## Two modes: (1) Emergent-hosted (single key) OR (2) Standalone/self-host.

## MongoDB (required)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="chipsutra_db"
CORS_ORIGINS="*"

## JWT (required) — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me-64-hex-chars"

## Bootstrap admin (created on first startup)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeMe-Str0ng!"

## Free-tier quota — generations/user/day (0 = unlimited; default OPEN for community)
FREE_DAILY_QUOTA=0

## Set to 'true' ONLY in production if you want to require email verification.
## Default 'false' keeps the self-hosted repo fully open for community users.
REQUIRE_EMAIL_VERIFICATION=false

APP_NAME="chipsutra"

## -------- Choose ONE LLM provider mode --------

## Mode A — Emergent-hosted (Emergent-only, single key powers everything)
# EMERGENT_LLM_KEY="sk-emergent-..."

## Mode B — Standalone (open-source SDKs, direct provider keys)
# ANTHROPIC_API_KEY="sk-ant-..."       # for Claude Sonnet 4.5
# OPENAI_API_KEY="sk-..."              # for GPT-5.2

## -------- Storage --------
## auto (default): Emergent if EMERGENT_LLM_KEY set, else local disk
## local:          always local disk (STORAGE_LOCAL_PATH)
## emergent:       force Emergent (requires EMERGENT_LLM_KEY)
STORAGE_MODE="auto"
STORAGE_LOCAL_PATH="./storage"

## -------- Google OAuth (optional) --------
## Emergent mode auto-enables if EMERGENT_LLM_KEY is set (no extra config).
## Standalone mode — create OAuth client at https://console.cloud.google.com/apis/credentials
## and set the values below. Leave blank to hide the Google sign-in button.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="https://your-backend.example.com/api/auth/google/callback"
# FRONTEND_URL="https://your-frontend.example.com"
