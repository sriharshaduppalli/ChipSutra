## ================== ChipSutra Backend .env ==================
## Zero-key setup: leave everything below as-is. `docker compose up` will
## spin up a local Ollama server with an open-source code model and you can
## start generating testbenches immediately — no API key needed.

## MongoDB (required)
## Default docker-compose uses local Mongo: mongodb://mongo:27017 (set automatically).
## If Docker Hub cannot pull mongo:6, use MongoDB Atlas + docker-compose.atlas.yml — see docs/DOCKER_PULL_TROUBLESHOOTING.md
MONGO_URL="mongodb://localhost:27017"
DB_NAME="chipsutra_db"
CORS_ORIGINS="*"

## JWT — auto-generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me-generate-64-hex-chars"

## Bootstrap admin (auto-created on first startup)
ADMIN_EMAIL="admin@chipsutra.local"
ADMIN_PASSWORD="ChangeMe-Str0ng!"

APP_NAME="chipsutra"

## Fully open community edition — no quotas, no email walls
FREE_DAILY_QUOTA=0
REQUIRE_EMAIL_VERIFICATION=false

## Optional: anonymous startup telemetry (privacy-safe, only sends install_id + version)
## Enable to help ChipSutra count active installations. Opt-out is default.
TELEMETRY_ENABLED=false
# CHIPSUTRA_INSTALL_ID=""  # optional — persist a single install UUID across restarts

## ==== LLM providers (auto-detected) ====
## The backend tries providers in this order:
##   1. EMERGENT_LLM_KEY (Emergent-hosted only)
##   2. ANTHROPIC_API_KEY (paid, best quality)
##   3. OPENAI_API_KEY (paid)
##   4. OLLAMA_URL (LOCAL, FREE, DEFAULT for self-host — zero API key required)
##
## Docker compose already sets OLLAMA_URL=http://ollama:11434 for you.
## You can leave this section blank and it will just work.

# EMERGENT_LLM_KEY=""
# ANTHROPIC_API_KEY=""              # optional, higher quality
# OPENAI_API_KEY=""                 # optional
OLLAMA_URL="http://ollama:11434"
# Local DV-tuned model (built by docker compose from models/chipsutra-vlsi/). No API credits.
OLLAMA_MODEL="chipsutra-vlsi:3b"
# Base weight tag pulled before `ollama create` (docker compose OLLAMA_BASE_MODEL)
# OLLAMA_BASE_MODEL="qwen2.5-coder:3b"
# Alternatives after running ChipSutra-VLSI-LLM scripts: chipsutra-vlsi:1.5b | chipsutra-vlsi:7b
# Raw Qwen (skip custom model): qwen2.5-coder:3b

## RAG (domain knowledge injection on Generate)
RAG_ENABLED=true

## Optional Redis — shared rate limits across workers/replicas
## Leave unset for single-process in-memory limiting (default).
## With Docker: docker compose --profile redis up  then set:
# REDIS_URL="redis://redis:6379/0"

## Storage — auto: emergent if key present, else local disk
STORAGE_MODE="auto"
STORAGE_LOCAL_PATH="./storage"

## Google OAuth (optional). Leave blank to hide the Google button.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""
# FRONTEND_URL=""
