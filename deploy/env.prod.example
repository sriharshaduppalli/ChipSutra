# Compose-level settings (non-secret). Copy to deploy/.env.prod
# cp deploy/env.prod.example deploy/.env.prod

# Public URLs — must match TLS hostnames in deploy/Caddyfile
PUBLIC_API_URL=https://api.chipsutra.org
PUBLIC_APP_URL=https://chipsutra.org

# Used in Caddyfile via env substitution when starting caddy (optional)
PUBLIC_APP_HOST=chipsutra.org
PUBLIC_API_HOST=api.chipsutra.org
ACME_EMAIL=ops@chipsutra.ai

OLLAMA_MODEL=chipsutra-vlsi:3b
OLLAMA_BASE_MODEL=qwen2.5-coder:3b
# Keep false so the portal shows ChipSutra-VLSI only (not Claude/GPT)
SHOW_CLOUD_MODELS=false

# Optional: pin images from GHCR after release (see .github/workflows/docker-publish.yml)
# BACKEND_IMAGE=ghcr.io/OWNER/chipsutra-backend:v1.0.0
# FRONTEND_IMAGE=ghcr.io/OWNER/chipsutra-frontend:v1.0.0
